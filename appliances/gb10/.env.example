# appliances/gb10/.env.example
# Copy to .env on the box, fill in real values, never commit .env.
#
# ==== Secrets the OWNER must supply ====

# Postgres password backing LiteLLM's own state (keys, teams, budgets, spend).
PG_PASSWORD=

# LiteLLM's own admin/master key — gates /ui, /team/*, /key/*, /metrics.
# Generate with: openssl rand -base64 32
LITELLM_MASTER_KEY=

# Tailscale auth key for tailnet `taile5d412` (NOT tail85625e — that is a
# personal tailnet). Generate at https://login.tailscale.com/admin/settings/keys
# MUST be tagged (tag:gb10) — an untagged key expires after 180 days by
# default, silently dropping the box off the tailnet. See Task 3 for the
# ACL tagOwners setup this depends on, and note that this key is consumed
# directly by `tailscale up` on the HOST (Task 3) — it is not read by
# docker compose at all, unlike every other secret below.
TAILSCALE_AUTHKEY=

# Grafana admin password (ops-only, reached via Tailscale, never public).
GRAFANA_ADMIN_PASSWORD=

# Slack incoming webhook URL for Alertmanager notifications.
ALERTMANAGER_SLACK_WEBHOOK_URL=

# Not a secret — shown verbatim in the key portal's "pending, not yet
# activated" message (D11, Task 11). Who a student/faculty member should
# contact to be promoted off the pending team.
ADMIN_CONTACT="your course instructor"

# Not a secret, but treat it carefully — comma-separated list of the UA
# (crimson.ua.edu / ua.edu) emails allowed onto the key portal's /admin
# view (security review, 2026-09-30). Matched case-insensitively with
# whitespace stripped. The portal refuses to start if this is blank —
# see app.py's require_admin()/_load_admin_emails(). Example:
# ADMIN_EMAILS=labmx@ua.edu,someone-else@crimson.ua.edu
ADMIN_EMAILS=

# Not a secret -- the key portal's own real external hostname, used by
# app.py's verify_same_origin() as the same-origin CSRF check's expected
# value for every state-changing POST (security review F5/B2,
# 2026-09-30). Must match exactly what students/admins actually type
# into their browser -- no scheme, no trailing slash, no port. The
# portal refuses to start if this is blank.
KEYPORTAL_HOSTNAME=local-llm-keys.uamishub.com

# Cloudflare Tunnel connector token for the already-created "gb10" tunnel
# (id e26a8629-b94d-4640-95ee-8c39c54df2c1, account
# ed63515eacde280b5e58dd875191cffb). Read from the tunnel's "Install and
# run a connector" page in the Zero Trust dashboard, or supplied directly
# by whoever holds it (Task 8) — never written into this repo as a value.
# Consumed by the cloudflared service's TUNNEL_TOKEN env var (Task 11).
CLOUDFLARE_TUNNEL_TOKEN=

# ==== Cloudflare identifiers ====

# The Cloudflare Access team domain. Already verified live: morning-cell-8cf6.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=morning-cell-8cf6.cloudflareaccess.com

# The "Application Audience" (AUD) tag from the Cloudflare Access
# Application guarding local-llm-keys.uamishub.com (Task 9/11) — unique
# per Application, so this one still has to be read off the dashboard.
CF_ACCESS_AUD_KEYPORTAL=

# ==== Generated by Task 7's provision-teams.sh — do not hand-edit ====

# D11: new identities land here by default with ZERO model access.
PENDING_TEAM_ID=
# D11 promotion targets — real access, granted manually by an admin.
STUDENTS_TEAM_ID=
FACULTY_TEAM_ID=
# ungraded is provisioned directly with real access; never a promotion
# target, never touched by the key portal.
UNGRADED_TEAM_ID=
