# appliances/gb10/alertmanager/alertmanager.yml.template
#
# The official prom/alertmanager image has no shell/envsubst inside the
# container, so ${ALERTMANAGER_SLACK_WEBHOOK_URL} cannot be templated at
# container start the usual compose way. render-config.sh (same directory's
# parent) renders this template into alertmanager/alertmanager.yml ON THE
# HOST before `docker compose up`, and the systemd unit
# (appliances/gb10/deploy/gb10-appliance.service) already calls that script
# as ExecStartPre on every boot. The rendered alertmanager.yml is gitignored
# (see appliances/gb10/.gitignore) — only this template is committed.
route:
  receiver: slack
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: slack
    slack_configs:
      - api_url: 'SLACK_WEBHOOK_URL_PLACEHOLDER'
        channel: '#gb10-alerts'
        send_resolved: true
        title: '{{ .CommonAnnotations.summary }}'
        text: '{{ .CommonAnnotations.description }}'
