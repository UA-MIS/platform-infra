# appliances/gb10/ida-llm/versions.env.example
# Copy to versions.env on the box. Same contract as the appliance's own
# versions.env: `docker compose` is invoked with BOTH
#   --env-file .env --env-file versions.env
# and these are interpolated into docker-compose.yml. Omit the second flag and
# every image ref renders empty.
#
# ⚠ THESE DIGESTS ARE arm64. This box is aarch64 (`uname -m` -> aarch64) and has
# NO binfmt/QEMU registered, so an amd64 image does not merely run slowly -- it
# fails to exec at all ("exec /bin/uname: exec format error", verified
# 2026-11-12). Never copy a digest from an x86 machine into this file. Always
# obtain it by pulling ON THE BOX and reading it back:
#
#   docker pull postgres:17-alpine
#   docker inspect --format '{{index .RepoDigests 0}}' postgres:17-alpine
#   docker inspect --format '{{.Architecture}}'        postgres:17-alpine   # must say arm64
#
# ⚠ NOT MIRRORED THROUGH HARBOR, AND THAT IS NOT AN OVERSIGHT. Harbor's
# base-images project is amd64-only (checked 2026-11-12: library/node:24.16-
# trixie-slim and library/python:3.12-slim-bookworm both report amd64), so the
# signed-mirror path this platform uses everywhere else cannot serve this box.
# These pull from Docker Hub directly, which means Docker Hub rate limits apply
# and Kyverno-style signature enforcement does not -- an accepted consequence of
# this directory already being outside GitOps and admission control. Mirroring
# arm64 variants into base-images is the clean fix and is noted as follow-up in
# the design doc.

# ---- off-the-shelf ----
# Digests below were captured on the box, 2026-11-12, and are arm64.
IDA_POSTGRES_DIGEST=postgres@sha256:e5d2edd28b1f8d40a0a6c0c9cdc545b19b56a0d5d88f94bc11a97d970d4700d0
IDA_REDIS_DIGEST=redis@sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe

# ---- the two app images ----
# With IDA_IMAGE_SOURCE=build these are TAGS the reconciler builds and writes
# itself, pinned to the reconciled commit (`ida-llm-python-app:<sha>`), so the
# running stack always names the exact source it came from. reconcile.sh rewrites
# these two lines in place on every successful build -- do not hand-edit them
# while the timer is active.
#
# With IDA_IMAGE_SOURCE=registry, set them to full digest refs instead, e.g.
#   IDA_PYTHON_IMAGE=harbor.capstone.uamishub.com/ida-llm/ida-llm-python-app@sha256:...
IDA_PYTHON_IMAGE=ida-llm-python-app:bootstrap
IDA_FRONTEND_IMAGE=ida-llm-frontend:bootstrap

# ---- build-time base images (IDA_IMAGE_SOURCE=build only) ----
# Dockerfile.python and frontend/Dockerfile both parameterise their base image
# (ARG PYTHON_IMAGE / ARG NODE_IMAGE) and default to the amd64-only Harbor
# mirror. The reconciler passes these as --build-arg overrides, which is why
# building on this box needs no fork of either Dockerfile.
IDA_BUILD_PYTHON_BASE=python@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
IDA_BUILD_NODE_BASE=node@sha256:45fbb3ca3b6c7e6646cd2889d0ac7bf314bb180036da792221fc2f48fe4d43fb
