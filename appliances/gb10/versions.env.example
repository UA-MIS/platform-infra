# appliances/gb10/versions.env.example
# Copy to versions.env on the box. Task 4 fills in the real @sha256 digest
# for each image by pulling it ON THE BOX (aarch64) and running `docker
# inspect`. Never hand-type a digest — always copy it from that command's
# output, and never revert any of these to a bare tag.
#
# Tailscale is NOT listed here — it runs natively on the host, not as a
# container (Task 3), so it has no image digest to pin in this file.

VLLM_DIGEST=vllm/vllm-openai@sha256:REPLACE_ME
LITELLM_DIGEST=ghcr.io/berriai/litellm@sha256:REPLACE_ME
POSTGRES_DIGEST=postgres@sha256:REPLACE_ME
CLOUDFLARED_DIGEST=cloudflare/cloudflared@sha256:REPLACE_ME
NODE_EXPORTER_DIGEST=quay.io/prometheus/node-exporter@sha256:REPLACE_ME
NVIDIA_GPU_EXPORTER_DIGEST=utkuozdemir/nvidia_gpu_exporter@sha256:REPLACE_ME
PROMETHEUS_DIGEST=prom/prometheus@sha256:REPLACE_ME
ALERTMANAGER_DIGEST=quay.io/prometheus/alertmanager@sha256:REPLACE_ME
GRAFANA_DIGEST=grafana/grafana-oss@sha256:REPLACE_ME
