{
  "name": "${{ values.appName }}",
  "version": "0.1.0",
  "private": true,
  "description": ${{ values.description | dump }},
  "scripts": {
    "dev": "next dev -p ${{ values.port }}",
    "build": "next build",
    "start": "next start -p ${{ values.port }}",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.2",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
