# npm resilience hardening — defence in depth against a stalling registry link.
# Mirrors fullstack/nextjs's .npmrc (kept in sync deliberately; see its comment for
# the full evidence pointer to UA-MIS/ida-llm PRs #74/#75).
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000
maxsockets=3
