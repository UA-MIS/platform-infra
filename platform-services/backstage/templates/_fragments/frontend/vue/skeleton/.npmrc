# npm resilience hardening — defence in depth against a stalling registry link.
#
# This tunes npm's OWN retry/timeout knobs. On this fleet it is NOT sufficient by
# itself against the Kaniko-build-time failure this exists to mitigate (see
# ./Dockerfile's install retry loop, which is the layer that actually survives
# it — proven necessary by UA-MIS/ida-llm PRs #74/#75: an
# npm_config_fetch_retries-only fix still failed in ~20s flat with errno -110,
# faster than any backoff schedule engages). This file still helps: the CI
# `checks` job's plain `npm ci`/`npm install` step (outside Docker) and any
# local install pick these up automatically since npm reads .npmrc from the
# working directory.
#
# fetch-* values match the fleet-wide convention set in UA-MIS/ida-llm's workflow
# env block, kept in sync deliberately. maxsockets lowers install concurrency in
# case parallel connections are contending for a flaky link inside the build pod.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000
maxsockets=3
