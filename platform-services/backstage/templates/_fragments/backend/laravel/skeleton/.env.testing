# Test-only environment (loaded automatically when APP_ENV=testing). Contains NO real
# secrets — the APP_KEY below is a throwaway used only by the test suite. Production config
# is injected via real environment variables (DATABASE_URL, APP_SECRET) by the platform.
APP_NAME="Capstone Laravel API"
APP_ENV=testing
APP_KEY=base64:MNVuLm3t2/hQFrJ1+ds7kKIn9sb1y+OFK4uzOaBI+Wo=
APP_DEBUG=true

LOG_CHANNEL=stderr
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# The test suite uses in-memory SQLite (no MySQL needed).
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
