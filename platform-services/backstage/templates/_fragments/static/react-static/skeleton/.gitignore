# React static-site starter (Vite build, served by nginx).
# The repo root has a .gitignore too; this one covers this component's stack.

# Dependencies
node_modules/

# Vite build output
dist/
dist-ssr/
*.tsbuildinfo

# Test / coverage
coverage/

# Local-only overrides
*.local

# Local env -- real secrets belong in Vault, not here.
# This site is fully static: anything Vite inlines as VITE_* ships to every
# visitor's browser. Never put a credential in one.
.env
.env.local
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
