{
  "name": "${{ values.appName }}",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": ${{ values.description | dump }},
  "scripts": {
    "dev": "vite dev --port ${{ values.port }}",
    "build": "vite build",
    "preview": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "mysql2": "^3.22.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.0",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.0",
    "drizzle-kit": "^0.31.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "esbuild": "^0.25.0"
  }
}
