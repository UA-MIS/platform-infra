{
  "name": "${{ values.appName }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "${{ values.description }}",
  "scripts": {
    "dev": "nuxt dev --port ${{ values.port }}",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "mysql2": "^3.22.0",
    "nuxt": "^3.21.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
