{
  "name": "${{ values.appName }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": ${{ values.description | dump }},
  "scripts": {
    "dev": "nuxt dev --port ${{ values.port }}",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.22.6",
    "nuxt": "^3.21.8",
    "vue": "^3.5.39",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
